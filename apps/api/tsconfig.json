{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "noEmit": true,
    "types": [
      "node"
    ],
  },
  "include": [
    "src"
  ],
  "allowImportingTsExtensions": true
}
