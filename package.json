{
  "name": "todo-app",
  "version": "2.0.0",
  "description": "Todo app with sharing, built with SolidStart, Drizzle and PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.3",
    "@solidjs/start": "^2.2.3",
    "@suid/icons-material": "^0.9.0",
    "@suid/material": "^0.19.0",
    "drizzle-orm": "^0.45.4",
    "nitro": "3.0.261103-rc",
    "pg": "^8.16.0",
    "solid-js": "^1.9.19",
    "vite": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.2"
  }
}